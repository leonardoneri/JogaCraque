// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  username      String   @unique
  password      String?
  teamName      String   @default("Meu Time")
  
  // Auth fields
  isGuest       Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  guestToken    String?  @unique
  
  // Game resources
  coins         Int      @default(1000)
  gems          Int      @default(50)
  transferFunds Int      @default(5000)
  
  // Progress
  level         Int      @default(1)
  xp            Int      @default(0)
  ratingMMR     Int      @default(1000)
  
  // Stats
  matchesPlayed Int      @default(0)
  wins          Int      @default(0)
  draws         Int      @default(0)
  losses        Int      @default(0)
  
  // Relations
  players       Player[]
  squad         Squad?
  marketListings MarketListing[]
  matchHistory  Match[]  @relation("PlayerMatches")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("users")
}

model CardTemplate {
  id            String   @id @default(uuid())
  baseId        String   // ID da carta base (ex: s4-00001)
  variation     String   // Variação da carta (ex: -1, -2)
  
  // Dados da carta
  name          String
  position      String   // Position enum as string
  nationality   String?
  club          String?
  collection    String   @default("Base")
  rarity        String   // Rarity enum as string
  
  // Stats
  rating        Int
  pace          Int
  shooting      Int
  passing       Int
  dribbling     Int
  defending     Int
  physical      Int
  vision        Int
  positioning   Int
  
  // Imagem
  image         String?
  
  // Validação (admin aprova antes de aparecer em pacotes)
  isValidated   Boolean  @default(false)
  
  // Relação com cartas de jogadores
  playerCards   Player[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Índice único para evitar duplicatas
  @@unique([baseId, variation])
  @@map("card_templates")
}

model Player {
  id            String   @id @default(uuid())
  
  // Referência ao template da carta
  templateId    String
  template      CardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  // Progressão individual desta carta
  level         Int      @default(1)
  xp            Int      @default(0)
  
  // Game stats
  matches       Int      @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  
  // Market
  marketValue   Int      @default(0)
  
  // Relations
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  squadId       String?
  squad         Squad?   @relation(fields: [squadId], references: [id])
  squadPosition Int?     // Índice (0-10) no campo
  
  marketListing MarketListing?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("players")
}

model Squad {
  id            String   @id @default(uuid())
  
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  formation     String   @default("4-3-3")
  
  // Squad positions (11 players)
  players       Player[]
  
  // Store positions as JSON for flexibility
  positions     Json     @default("[]")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("squads")
}

model Match {
  id            String   @id @default(uuid())
  
  // Match info
  homeUserId    String
  homeUser      User     @relation("PlayerMatches", fields: [homeUserId], references: [id])
  
  opponentName  String   // Nome do oponente (pode ser IA)
  opponentSquad Json     // Squad do oponente
  
  // Result
  homeScore     Int
  awayScore     Int
  result        String   // 'V', 'D', 'E'
  
  // Match data
  events        Json     @default("[]")
  duration      Int      @default(90)
  
  // Rewards
  coinsEarned   Int      @default(0)
  xpEarned      Int      @default(0)
  
  // Match type
  matchType     String   // 'RANKED', 'FRIENDLY', 'CAMPAIGN'
  
  createdAt     DateTime @default(now())
  
  @@map("matches")
}

model MarketListing {
  id            String   @id @default(uuid())
  
  playerId      String   @unique
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  sellerId      String
  seller        User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  price         Int
  
  expiresAt     DateTime
  
  createdAt     DateTime @default(now())
  
  @@map("market_listings")
}
